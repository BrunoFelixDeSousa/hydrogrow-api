Project hidroponic_api {
  database_type: 'PostgreSQL'
  Note: 'Modelo alvo: sessões revogáveis, vínculos explícitos e integridade por tenant. JWT usa sid; não é armazenado no banco.'
}

Table users {
  Note: 'Identidade global e credenciais. Sem refresh ou reset nesta tabela; perfil, vínculos e sessões são entidades próprias.'
  id uuid [pk, default: `gen_random_uuid()`]
  email text [not null]
  password_hash text [not null]
  is_active boolean [not null, default: true]
  email_verified boolean [not null, default: false]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `email = lower(btrim(email)) AND length(email) BETWEEN 3 AND 255` [name: 'ck_users_email_normalized']
  }
  indexes {
    email [unique, name: 'uq_users_email']
  }
}

Table profiles {
  Note: 'Um perfil global por usuário. O tenant apresentado no DTO vem da sessão autorizada, não desta tabela.'
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  full_name text [not null]
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(full_name)) BETWEEN 2 AND 100` [name: 'ck_profiles_full_name']
  }
  indexes {
    user_id [unique, name: 'uq_profiles_user_id']
  }
}

Table plans {
  Note: 'Catálogo comercial. Valores monetários em BRL; limite NULL significa ilimitado.'
  id text [pk]
  label text [not null]
  price numeric(18,2) [not null, default: 0]
  product_limit integer
  user_limit integer
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `price >= 0` [name: 'ck_plans_price']
    `(product_limit IS NULL OR product_limit > 0) AND (user_limit IS NULL OR user_limit > 0)` [name: 'ck_plans_limits']
  }
}

Table tenants {
  Note: 'Empresa. plan e subscription_active são a projeção de acesso comercial mantida pelo caso de uso de billing.'
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  document text
  email text
  phone text
  address text
  city text
  state text
  zip_code text
  plan text [not null, default: 'basico']
  is_active boolean [not null, default: true]
  subscription_active boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) BETWEEN 2 AND 100` [name: 'ck_tenants_name']
    `state IS NULL OR state ~ '^[A-Z]{2}$'` [name: 'ck_tenants_state']
  }
  indexes {
    plan [name: 'ix_tenants_plan']
  }
}

Table tenant_memberships {
  Note: 'Vínculo explícito usuário/empresa. Desativar em vez de excluir para preservar autoria e sessões históricas.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, user_id) [unique, name: 'uq_tenant_memberships_tenant_id_user_id']
    (tenant_id, id) [unique, name: 'uq_tenant_memberships_tenant_id_id']
    (user_id, is_active) [name: 'ix_tenant_memberships_user_id_is_active']
  }
}

Table membership_roles {
  Note: 'Papéis do vínculo. Super admin é global e nunca pode ser atribuído aqui.'
  membership_id uuid [not null]
  role text [not null]
  checks {
    `role IN ('admin', 'operator', 'financial')` [name: 'ck_membership_roles_role']
  }
  indexes {
    (membership_id, role) [pk, name: 'pk_membership_roles_membership_id_role']
  }
}

Table super_admins {
  Note: 'Privilégio administrativo global; não elimina os filtros de tenant nas rotas operacionais.'
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    user_id [unique, name: 'uq_super_admins_user_id']
  }
}

Table auth_sessions {
  Note: 'Uma sessão por login/contexto/dispositivo. sid do JWT referencia id. Revogação é consultada em toda requisição. Expiração absoluta: 30 dias.'
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  tenant_id uuid
  scope text [not null, default: 'tenant']
  device_label text
  user_agent text
  created_ip inet
  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason text
  checks {
    `(scope = 'tenant' AND tenant_id IS NOT NULL) OR (scope = 'global' AND tenant_id IS NULL)` [name: 'ck_auth_sessions_scope']
    `expires_at > created_at` [name: 'ck_auth_sessions_expires']
    `(revoked_at IS NULL AND revoke_reason IS NULL) OR (revoked_at IS NOT NULL AND revoke_reason IS NOT NULL)` [name: 'ck_auth_sessions_revocation']
  }
  indexes {
    (user_id, revoked_at) [name: 'ix_auth_sessions_user_id_revoked_at']
    (tenant_id, user_id) [name: 'ix_auth_sessions_tenant_id_user_id']
    expires_at [name: 'ix_auth_sessions_expires_at']
  }
}

Table refresh_tokens {
  Note: 'Uma linha por emissão; SHA-256 hexadecimal de token opaco com 32 bytes aleatórios. Histórico preserva a família (session_id). SQL inclui índices parciais para um token aberto e uma raiz por sessão.'
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  token_hash text [not null]
  parent_token_id uuid
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  checks {
    `token_hash ~ '^[0-9a-f]{64}$'` [name: 'ck_refresh_tokens_hash']
    `expires_at > created_at` [name: 'ck_refresh_tokens_expiry']
    `parent_token_id IS NULL OR parent_token_id <> id` [name: 'ck_refresh_tokens_parent']
    `consumed_at IS NULL OR consumed_at >= created_at` [name: 'ck_refresh_tokens_consumed']
  }
  indexes {
    token_hash [unique, name: 'uq_refresh_tokens_token_hash']
    (session_id, id) [unique, name: 'uq_refresh_tokens_session_id_id']
    parent_token_id [unique, name: 'uq_refresh_tokens_parent_token_id']
    expires_at [name: 'ix_refresh_tokens_expires_at']
  }
}

Table password_reset_tokens {
  Note: 'Token opaco de uso único, SHA-256, validade de uma hora. SQL limita a um token aberto por usuário; novo pedido revoga os anteriores.'
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  checks {
    `token_hash ~ '^[0-9a-f]{64}$'` [name: 'ck_password_reset_tokens_hash']
    `expires_at > created_at` [name: 'ck_password_reset_tokens_expiry']
    `consumed_at IS NULL OR consumed_at >= created_at` [name: 'ck_password_reset_tokens_consumed']
  }
  indexes {
    token_hash [unique, name: 'uq_password_reset_tokens_token_hash']
    user_id [name: 'ix_password_reset_tokens_user_id']
    expires_at [name: 'ix_password_reset_tokens_expires_at']
  }
}

Table product_categories {
  Note: 'Categorias próprias de cada empresa.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) > 0` [name: 'ck_product_categories_name']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_product_categories_tenant_id_id']
    (tenant_id, name) [unique, name: 'uq_product_categories_tenant_id_name']
  }
}

Table products {
  Note: 'Catálogo. Lote, validade e saldo pertencem a inventory_lots; currentStock no DTO é SUM(current_stock) dos lotes. Unidade não muda após movimentação.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  category_id uuid
  name text [not null]
  sku text
  unit text [not null, default: 'un']
  cost_price numeric(18,4) [not null, default: 0]
  sale_price numeric(18,4) [not null, default: 0]
  min_stock numeric(18,3) [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) > 0` [name: 'ck_products_name']
    `cost_price >= 0 AND sale_price >= 0 AND min_stock >= 0` [name: 'ck_products_prices']
    `sku IS NULL OR (sku = upper(btrim(sku)) AND length(sku) > 0)` [name: 'ck_products_sku']
    `unit IN ('un', 'kg', 'g', 'L', 'mL', 'cx')` [name: 'ck_products_unit']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_products_tenant_id_id']
    (tenant_id, sku) [unique, name: 'uq_products_tenant_id_sku']
    (tenant_id, category_id) [name: 'ix_products_tenant_id_category_id']
    (tenant_id, is_active) [name: 'ix_products_tenant_id_is_active']
  }
}

Table customers {
  Note: 'Parceiro por tenant. Documento opcional normalizado sem pontuação; vazio vira NULL. FKs impedem excluir parceiros utilizados.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  document text
  email text
  phone text
  address text
  city text
  state text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) > 0` [name: 'ck_customers_name']
    `document IS NULL OR document ~ '^([0-9]{11}|[0-9]{14})$'` [name: 'ck_customers_document']
    `state IS NULL OR state ~ '^[A-Z]{2}$'` [name: 'ck_customers_state']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_customers_tenant_id_id']
    (tenant_id, document) [unique, name: 'uq_customers_tenant_id_document']
    (tenant_id, name) [name: 'ix_customers_tenant_id_name']
  }
}

Table suppliers {
  Note: 'Parceiro por tenant. Documento opcional normalizado sem pontuação; vazio vira NULL. FKs impedem excluir parceiros utilizados.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  document text
  email text
  phone text
  address text
  city text
  state text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) > 0` [name: 'ck_suppliers_name']
    `document IS NULL OR document ~ '^([0-9]{11}|[0-9]{14})$'` [name: 'ck_suppliers_document']
    `state IS NULL OR state ~ '^[A-Z]{2}$'` [name: 'ck_suppliers_state']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_suppliers_tenant_id_id']
    (tenant_id, document) [unique, name: 'uq_suppliers_tenant_id_document']
    (tenant_id, name) [name: 'ix_suppliers_tenant_id_name']
  }
}

Table sales {
  Note: 'Venda: open, completed, cancelled. Total recalculado no servidor. Conclusão, estoque e financeiro na mesma transação.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  customer_id uuid
  user_id uuid [not null]
  total numeric(18,2) [not null, default: 0]
  discount numeric(18,2) [not null, default: 0]
  payment_method text
  status text [not null, default: 'open']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `total >= 0` [name: 'ck_sales_total']
    `discount >= 0` [name: 'ck_sales_discount']
    `status IN ('open', 'completed', 'cancelled')` [name: 'ck_sales_status']
    `status <> 'completed' OR total > 0` [name: 'ck_sales_final_total']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_sales_tenant_id_id']
    (tenant_id, created_at) [name: 'ix_sales_tenant_id_created_at']
    (tenant_id, customer_id) [name: 'ix_sales_tenant_id_customer_id']
    (tenant_id, user_id) [name: 'ix_sales_tenant_id_user_id']
  }
}

Table sale_items {
  Note: 'Preço, unidade e nome são snapshots comerciais. Um produto por documento; alocações de vários lotes são representadas nos movimentos.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  sale_id uuid [not null]
  product_id uuid [not null]
  product_name text [not null]
  unit text [not null]
  quantity numeric(18,3) [not null]
  unit_price numeric(18,4) [not null]
  total numeric(18,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  checks {
    `quantity > 0` [name: 'ck_sale_items_quantity']
    `unit_price >= 0` [name: 'ck_sale_items_price']
    `total = round(quantity * unit_price, 2)` [name: 'ck_sale_items_total']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_sale_items_tenant_id_id']
    (tenant_id, id, product_id) [unique, name: 'uq_sale_items_tenant_id_id_product_id']
    (tenant_id, sale_id, product_id) [unique, name: 'uq_sale_items_tenant_id_sale_id_product_id']
    (tenant_id, product_id) [name: 'ix_sale_items_tenant_id_product_id']
  }
}

Table purchases {
  Note: 'Compra: open, received, cancelled. Recebimento, estoque e financeiro na mesma transação.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  supplier_id uuid
  user_id uuid [not null]
  invoice_number text
  total numeric(18,2) [not null, default: 0]
  status text [not null, default: 'open']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `total >= 0` [name: 'ck_purchases_total']
    `status IN ('open', 'received', 'cancelled')` [name: 'ck_purchases_status']
    `status <> 'received' OR total > 0` [name: 'ck_purchases_final_total']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_purchases_tenant_id_id']
    (tenant_id, created_at) [name: 'ix_purchases_tenant_id_created_at']
    (tenant_id, supplier_id) [name: 'ix_purchases_tenant_id_supplier_id']
    (tenant_id, user_id) [name: 'ix_purchases_tenant_id_user_id']
  }
}

Table purchase_items {
  Note: 'Preço, unidade e nome são snapshots comerciais. Um produto por documento; alocações de vários lotes são representadas nos movimentos.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  purchase_id uuid [not null]
  product_id uuid [not null]
  product_name text [not null]
  unit text [not null]
  quantity numeric(18,3) [not null]
  unit_price numeric(18,4) [not null]
  total numeric(18,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  checks {
    `quantity > 0` [name: 'ck_purchase_items_quantity']
    `unit_price >= 0` [name: 'ck_purchase_items_price']
    `total = round(quantity * unit_price, 2)` [name: 'ck_purchase_items_total']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_purchase_items_tenant_id_id']
    (tenant_id, id, product_id) [unique, name: 'uq_purchase_items_tenant_id_id_product_id']
    (tenant_id, purchase_id, product_id) [unique, name: 'uq_purchase_items_tenant_id_purchase_id_product_id']
    (tenant_id, product_id) [name: 'ix_purchase_items_tenant_id_product_id']
  }
}

Table crops {
  Note: 'Modelo agronômico. O produto e a unidade são copiados para o lote de produção no plantio.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  variety text
  cycle_days integer
  estimated_yield numeric(18,3)
  yield_unit text [not null, default: 'kg']
  notes text
  product_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(name)) > 0` [name: 'ck_crops_name']
    `cycle_days IS NULL OR cycle_days > 0` [name: 'ck_crops_cycle']
    `estimated_yield IS NULL OR estimated_yield > 0` [name: 'ck_crops_yield']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_crops_tenant_id_id']
    (tenant_id, product_id) [name: 'ix_crops_tenant_id_product_id']
  }
}

Table production_batches {
  Note: 'Ciclo de plantio. Produto e unidade de saída são snapshots. Uma colheita final no escopo atual; perdas não são status separado. Custos gerenciais não geram despesa duplicada de compras.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  crop_id uuid [not null]
  product_id uuid [not null]
  yield_unit text [not null]
  batch_code text [not null]
  start_date date [not null]
  expected_harvest date
  actual_harvest date
  quantity_planted numeric(18,3) [not null]
  quantity_harvested numeric(18,3)
  germination_loss numeric(5,4) [not null, default: 0]
  loss_quantity numeric(18,3) [not null, default: 0]
  cost_seedlings numeric(18,2) [not null, default: 0]
  cost_inputs numeric(18,2) [not null, default: 0]
  cost_labor numeric(18,2) [not null, default: 0]
  cost_other numeric(18,2) [not null, default: 0]
  status text [not null, default: 'growing']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(batch_code)) > 0` [name: 'ck_production_batches_code']
    `(expected_harvest IS NULL OR expected_harvest >= start_date) AND (actual_harvest IS NULL OR actual_harvest >= start_date)` [name: 'ck_production_batches_dates']
    `quantity_planted > 0 AND (quantity_harvested IS NULL OR quantity_harvested > 0) AND loss_quantity BETWEEN 0 AND quantity_planted` [name: 'ck_production_batches_quantities']
    `germination_loss BETWEEN 0 AND 1` [name: 'ck_production_batches_germination']
    `cost_seedlings >= 0 AND cost_inputs >= 0 AND cost_labor >= 0 AND cost_other >= 0` [name: 'ck_production_batches_costs']
    `status IN ('growing', 'harvested', 'cancelled')` [name: 'ck_production_batches_status']
    `(status = 'harvested' AND actual_harvest IS NOT NULL AND quantity_harvested IS NOT NULL) OR (status <> 'harvested' AND actual_harvest IS NULL AND quantity_harvested IS NULL)` [name: 'ck_production_batches_harvest']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_production_batches_tenant_id_id']
    (tenant_id, id, product_id) [unique, name: 'uq_production_batches_tenant_id_id_product_id']
    (tenant_id, batch_code) [unique, name: 'uq_production_batches_tenant_id_batch_code']
    (tenant_id, crop_id) [name: 'ix_production_batches_tenant_id_crop_id']
    (tenant_id, product_id) [name: 'ix_production_batches_tenant_id_product_id']
    (tenant_id, status, expected_harvest) [name: 'ix_production_batches_tenant_id_status_expected_harvest']
  }
}

Table inventory_lots {
  Note: 'Lote físico de estoque por produto, inclusive um lote interno para itens sem lote comercial. Saldo materializado inicia zero e é atualizado junto com o movimento. Validade opcional.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  product_id uuid [not null]
  lot_code text [not null]
  received_at timestamptz [not null, default: `now()`]
  expiry_date date
  production_batch_id uuid
  current_stock numeric(18,3) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `length(btrim(lot_code)) > 0` [name: 'ck_inventory_lots_code']
    `current_stock >= 0` [name: 'ck_inventory_lots_stock']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_inventory_lots_tenant_id_id']
    (tenant_id, id, product_id) [unique, name: 'uq_inventory_lots_tenant_id_id_product_id']
    (tenant_id, product_id, lot_code) [unique, name: 'uq_inventory_lots_tenant_id_product_id_lot_code']
    (tenant_id, production_batch_id) [unique, name: 'uq_inventory_lots_tenant_id_production_batch_id']
    (tenant_id, product_id, expiry_date) [name: 'ix_inventory_lots_tenant_id_product_id_expiry_date']
  }
}

Table stock_movements {
  Note: 'Razão imutável de estoque. Delta assinado; estorno por novo registro ligado ao original. Origem tipada com FK. operation_key estável por comando/item/lote garante idempotência.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  product_id uuid [not null]
  lot_id uuid [not null]
  type text [not null]
  quantity_delta numeric(18,3) [not null]
  operation_key text [not null]
  sale_item_id uuid
  purchase_item_id uuid
  production_batch_id uuid
  reversal_of_id uuid
  notes text
  user_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  checks {
    `quantity_delta <> 0` [name: 'ck_stock_movements_delta']
    `(type = 'entry' AND quantity_delta > 0) OR (type = 'exit' AND quantity_delta < 0) OR type IN ('adjustment', 'reversal')` [name: 'ck_stock_movements_type']
    `num_nonnulls(sale_item_id, purchase_item_id, production_batch_id, reversal_of_id) <= 1` [name: 'ck_stock_movements_origin']
    `(type = 'reversal') = (reversal_of_id IS NOT NULL)` [name: 'ck_stock_movements_reversal']
    `(sale_item_id IS NULL OR type = 'exit') AND (purchase_item_id IS NULL OR type = 'entry') AND (production_batch_id IS NULL OR type = 'entry')` [name: 'ck_stock_movements_origin_type']
    `num_nonnulls(sale_item_id, purchase_item_id, production_batch_id, reversal_of_id) > 0 OR (notes IS NOT NULL AND length(btrim(notes)) > 0)` [name: 'ck_stock_movements_manual_note']
    `length(btrim(operation_key)) > 0` [name: 'ck_stock_movements_operation_key']
    `reversal_of_id IS NULL OR reversal_of_id <> id` [name: 'ck_stock_movements_self_reversal']
  }
  indexes {
    (tenant_id, id, lot_id, product_id) [unique, name: 'uq_stock_movements_tenant_id_id_lot_id_product_id']
    (tenant_id, operation_key) [unique, name: 'uq_stock_movements_tenant_id_operation_key']
    reversal_of_id [unique, name: 'uq_stock_movements_reversal_of_id']
    (tenant_id, product_id, created_at) [name: 'ix_stock_movements_tenant_id_product_id_created_at']
    (tenant_id, lot_id, product_id) [name: 'ix_stock_movements_tenant_id_lot_id_product_id']
    (tenant_id, sale_item_id, product_id) [name: 'ix_stock_movements_tenant_id_sale_item_id_product_id']
    (tenant_id, purchase_item_id, product_id) [name: 'ix_stock_movements_tenant_id_purchase_item_id_product_id']
    (tenant_id, production_batch_id, product_id) [name: 'ix_stock_movements_tenant_id_production_batch_id_product_id']
    (tenant_id, user_id) [name: 'ix_stock_movements_tenant_id_user_id']
  }
}

Table financial_transactions {
  Note: 'Contas a receber/pagar, não contabilidade de partidas dobradas. Uma conta por venda/compra no MVP. overdue é derivado de pending e due_date; pagamento integral.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  type text [not null]
  description text [not null]
  amount numeric(18,2) [not null]
  due_date date [not null]
  paid_date date
  status text [not null, default: 'pending']
  sale_id uuid
  purchase_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `type IN ('receivable', 'payable')` [name: 'ck_financial_transactions_type']
    `length(btrim(description)) > 0` [name: 'ck_financial_transactions_description']
    `amount > 0` [name: 'ck_financial_transactions_amount']
    `status IN ('pending', 'paid', 'cancelled')` [name: 'ck_financial_transactions_status']
    `(status = 'paid') = (paid_date IS NOT NULL)` [name: 'ck_financial_transactions_paid']
    `num_nonnulls(sale_id, purchase_id) <= 1` [name: 'ck_financial_transactions_origin']
    `(sale_id IS NULL OR type = 'receivable') AND (purchase_id IS NULL OR type = 'payable')` [name: 'ck_financial_transactions_origin_type']
  }
  indexes {
    (tenant_id, id) [unique, name: 'uq_financial_transactions_tenant_id_id']
    (tenant_id, sale_id) [unique, name: 'uq_financial_transactions_tenant_id_sale_id']
    (tenant_id, purchase_id) [unique, name: 'uq_financial_transactions_tenant_id_purchase_id']
    (tenant_id, status, due_date) [name: 'ix_financial_transactions_tenant_id_status_due_date']
  }
}

Table technical_readings {
  Note: 'Leituras vinculadas ao lote e tenant. Limites físicos aceitos pelo domínio, não faixa agronômica ideal.'
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  batch_id uuid [not null]
  ph numeric(4,2)
  ec numeric(8,3)
  temperature numeric(6,2)
  recorded_by uuid [not null]
  recorded_at timestamptz [not null, default: `now()`]
  notes text
  checks {
    `num_nonnulls(ph, ec, temperature) >= 1` [name: 'ck_technical_readings_measurement']
    `ph IS NULL OR ph BETWEEN 0 AND 14` [name: 'ck_technical_readings_ph']
    `ec IS NULL OR ec >= 0` [name: 'ck_technical_readings_ec']
    `temperature IS NULL OR temperature BETWEEN -50 AND 80` [name: 'ck_technical_readings_temperature']
  }
  indexes {
    (tenant_id, batch_id, recorded_at) [name: 'ix_technical_readings_tenant_id_batch_id_recorded_at']
    (tenant_id, recorded_by) [name: 'ix_technical_readings_tenant_id_recorded_by']
  }
}

Ref fk_profiles_1: profiles.user_id > users.id [delete: restrict]
Ref fk_tenants_1: tenants.plan > plans.id [delete: restrict]
Ref fk_tenant_memberships_1: tenant_memberships.tenant_id > tenants.id [delete: restrict]
Ref fk_tenant_memberships_2: tenant_memberships.user_id > users.id [delete: restrict]
Ref fk_membership_roles_1: membership_roles.membership_id > tenant_memberships.id [delete: restrict]
Ref fk_super_admins_1: super_admins.user_id > users.id [delete: restrict]
Ref fk_auth_sessions_1: auth_sessions.user_id > users.id [delete: restrict]
Ref fk_auth_sessions_2: auth_sessions.tenant_id > tenants.id [delete: restrict]
Ref fk_auth_sessions_3: auth_sessions.(tenant_id, user_id) > tenant_memberships.(tenant_id, user_id) [delete: restrict]
Ref fk_refresh_tokens_1: refresh_tokens.session_id > auth_sessions.id [delete: restrict]
Ref fk_refresh_tokens_2: refresh_tokens.(session_id, parent_token_id) > refresh_tokens.(session_id, id) [delete: restrict]
Ref fk_password_reset_tokens_1: password_reset_tokens.user_id > users.id [delete: restrict]
Ref fk_product_categories_1: product_categories.tenant_id > tenants.id [delete: restrict]
Ref fk_products_1: products.tenant_id > tenants.id [delete: restrict]
Ref fk_products_2: products.(tenant_id, category_id) > product_categories.(tenant_id, id) [delete: restrict]
Ref fk_customers_1: customers.tenant_id > tenants.id [delete: restrict]
Ref fk_suppliers_1: suppliers.tenant_id > tenants.id [delete: restrict]
Ref fk_sales_1: sales.tenant_id > tenants.id [delete: restrict]
Ref fk_sales_2: sales.(tenant_id, customer_id) > customers.(tenant_id, id) [delete: restrict]
Ref fk_sales_3: sales.(tenant_id, user_id) > tenant_memberships.(tenant_id, user_id) [delete: restrict]
Ref fk_sale_items_1: sale_items.tenant_id > tenants.id [delete: restrict]
Ref fk_sale_items_2: sale_items.(tenant_id, sale_id) > sales.(tenant_id, id) [delete: restrict]
Ref fk_sale_items_3: sale_items.(tenant_id, product_id) > products.(tenant_id, id) [delete: restrict]
Ref fk_purchases_1: purchases.tenant_id > tenants.id [delete: restrict]
Ref fk_purchases_2: purchases.(tenant_id, supplier_id) > suppliers.(tenant_id, id) [delete: restrict]
Ref fk_purchases_3: purchases.(tenant_id, user_id) > tenant_memberships.(tenant_id, user_id) [delete: restrict]
Ref fk_purchase_items_1: purchase_items.tenant_id > tenants.id [delete: restrict]
Ref fk_purchase_items_2: purchase_items.(tenant_id, purchase_id) > purchases.(tenant_id, id) [delete: restrict]
Ref fk_purchase_items_3: purchase_items.(tenant_id, product_id) > products.(tenant_id, id) [delete: restrict]
Ref fk_crops_1: crops.tenant_id > tenants.id [delete: restrict]
Ref fk_crops_2: crops.(tenant_id, product_id) > products.(tenant_id, id) [delete: restrict]
Ref fk_production_batches_1: production_batches.tenant_id > tenants.id [delete: restrict]
Ref fk_production_batches_2: production_batches.(tenant_id, crop_id) > crops.(tenant_id, id) [delete: restrict]
Ref fk_production_batches_3: production_batches.(tenant_id, product_id) > products.(tenant_id, id) [delete: restrict]
Ref fk_inventory_lots_1: inventory_lots.tenant_id > tenants.id [delete: restrict]
Ref fk_inventory_lots_2: inventory_lots.(tenant_id, product_id) > products.(tenant_id, id) [delete: restrict]
Ref fk_inventory_lots_3: inventory_lots.(tenant_id, production_batch_id, product_id) > production_batches.(tenant_id, id, product_id) [delete: restrict]
Ref fk_stock_movements_1: stock_movements.tenant_id > tenants.id [delete: restrict]
Ref fk_stock_movements_2: stock_movements.(tenant_id, lot_id, product_id) > inventory_lots.(tenant_id, id, product_id) [delete: restrict]
Ref fk_stock_movements_3: stock_movements.(tenant_id, sale_item_id, product_id) > sale_items.(tenant_id, id, product_id) [delete: restrict]
Ref fk_stock_movements_4: stock_movements.(tenant_id, purchase_item_id, product_id) > purchase_items.(tenant_id, id, product_id) [delete: restrict]
Ref fk_stock_movements_5: stock_movements.(tenant_id, production_batch_id, product_id) > production_batches.(tenant_id, id, product_id) [delete: restrict]
Ref fk_stock_movements_6: stock_movements.(tenant_id, reversal_of_id, lot_id, product_id) > stock_movements.(tenant_id, id, lot_id, product_id) [delete: restrict]
Ref fk_stock_movements_7: stock_movements.(tenant_id, user_id) > tenant_memberships.(tenant_id, user_id) [delete: restrict]
Ref fk_financial_transactions_1: financial_transactions.tenant_id > tenants.id [delete: restrict]
Ref fk_financial_transactions_2: financial_transactions.(tenant_id, sale_id) > sales.(tenant_id, id) [delete: restrict]
Ref fk_financial_transactions_3: financial_transactions.(tenant_id, purchase_id) > purchases.(tenant_id, id) [delete: restrict]
Ref fk_technical_readings_1: technical_readings.tenant_id > tenants.id [delete: restrict]
Ref fk_technical_readings_2: technical_readings.(tenant_id, batch_id) > production_batches.(tenant_id, id) [delete: restrict]
Ref fk_technical_readings_3: technical_readings.(tenant_id, recorded_by) > tenant_memberships.(tenant_id, user_id) [delete: restrict]
