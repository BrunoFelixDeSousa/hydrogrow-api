#!/usr/bin/env sh

set -eu

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log_step() {
    printf "${BLUE}➜ %s${NC}\n" "$1"
}

trap 'printf "${RED}❌ Pre-commit interrompido por falhas.${NC}\n"; exit 1' EXIT

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Executando validações de Pre-Commit"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

log_step "1/3 Checando formatação (Spotless)..."
./mvnw -B -q spotless:check

log_step "2/3 Checando estilo de código (Checkstyle)..."
./mvnw -B -q checkstyle:check

log_step "3/3 Executando testes unitários..."
./mvnw -B -q test

trap - EXIT

printf "${GREEN}✅ Pre-commit concluído com sucesso!${NC}\n"