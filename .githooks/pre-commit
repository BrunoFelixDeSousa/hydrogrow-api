#!/usr/bin/env sh

set -eu

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log_step() {
    printf "${BLUE}➜ %s${NC}\n" "$1"
}

trap 'printf "${RED}❌ Pre-commit interrompido por falhas.${NC}\n"; exit 1' EXIT

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Executando validações de Pre-Commit"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

log_step "1/5 Checando formatação (Spotless)..."
./mvnw -B -q spotless:check

log_step "2/5 Checando estilo de código (Checkstyle)..."
./mvnw -B -q checkstyle:check

log_step "3/5 Checando análise estática (Error Prone)..."
./mvnw -B clean test-compile

log_step "4/5 Checando bytecode (SpotBugs)..."
./mvnw -B compile spotbugs:check

log_step "5/5 Executando testes unitários..."
./mvnw -B -q test

trap - EXIT

printf "${GREEN}✅ Pre-commit concluído com sucesso!${NC}\n"